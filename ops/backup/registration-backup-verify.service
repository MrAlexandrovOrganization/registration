[Unit]
Description=Restore latest registration backup into isolated PostgreSQL
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=maxim
Group=maxim
ExecStart=/usr/bin/python3 /home/maxim/.local/lib/registration-backup/registration_backup.py verify
TimeoutStartSec=20min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/maxim/backups/registration
